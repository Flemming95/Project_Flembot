{
    "provider": "openai",
    "model": "gpt-4o-mini",
    "api_key_env_var": "OPENAI_API_KEY",
    "max_tokens": 150,
    "temperature": 0.1,
    "timeout_seconds": 30,
    "alternative_providers": {
        "anthropic": {
            "model": "claude-3-haiku-20240307",
            "api_key_env_var": "ANTHROPIC_API_KEY"
        },
        "azure_openai": {
            "model": "gpt-4o-mini",
            "api_key_env_var": "AZURE_OPENAI_API_KEY",
            "endpoint_env_var": "AZURE_OPENAI_ENDPOINT"
        }
    }
}
